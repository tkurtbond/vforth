#!/bin/sh
# Copies files to [.VFORTH] in the vtil account on the VAX by FTP, in
# active and ASCII mode (so VMS stores them as variable-length records),
# each under its own name in uppercase.  The login and password come
# from ~/.netrc-vtil-vax (or $VAX_NETRC), never the command line.
#
#   tools/vax-put <file>...
host=${VAX_HOST:-192.168.2.20}
netrc=${VAX_NETRC:-$HOME/.netrc-vtil-vax}
dir=${VAX_DIR:-%5B.VFORTH%5D}
status=0
for f; do
  curl -s -S --max-time 120 --netrc-file "$netrc" -P - --use-ascii -T "$f" \
    "ftp://$host/$dir/$(basename "$f" | tr a-z A-Z)" || status=1
done
exit $status
