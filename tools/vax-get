#!/bin/sh
# Copies files from [.VFORTH] in the vtil account on the VAX by FTP, in
# active and ASCII mode, into the current directory, lowercased.
#
#   tools/vax-get <NAME.EXT>...
host=${VAX_HOST:-192.168.2.20}
netrc=${VAX_NETRC:-$HOME/.netrc-vtil-vax}
dir=${VAX_DIR:-%5B.VFORTH%5D}
status=0
for f; do
  curl -s -S --max-time 120 --netrc-file "$netrc" -P - --use-ascii \
    -o "$(echo "$f" | tr A-Z a-z)" "ftp://$host/$dir/$f" || status=1
done
exit $status
