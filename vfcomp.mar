;+++
;s> s_parseescaped -- parse a string ending with " that may contain \
;	escapes, translating it into v_xbuf.  r6, r7 = the result.
;---
s_parseescaped:
	addl3	v_srcaddr,v_toin,r1	; source
	subl3	v_toin,v_srclen,r2	; characters left
	moval	v_xbuf,r3		; result
10$:	tstl	r2
	bgtr	11$
	brw	90$
11$:	movzbl	(r1)+,r0
	decl	r2
	cmpb	r0,#^a/"/		; the end?
	bneq	12$
	brw	90$
12$:	cmpb	r0,#^a/\/
	beql	20$
15$:	movb	r0,(r3)+
	brb	10$
20$:	tstl	r2
	bleq	90$
	movzbl	(r1)+,r0
	decl	r2
	moval	v_escapes,r4		; look up the simple ones
25$:	tstb	(r4)
	beql	30$
	cmpb	r0,(r4)+
	beql	27$
	incl	r4
	brb	25$
27$:	movb	(r4),r0
	brb	15$
30$:	cmpb	r0,#^a/m/		; \m is CR LF
	bneq	40$
	movb	#13,(r3)+
	movb	#10,r0
	brb	15$
40$:	cmpb	r0,#^a/x/		; \x and two hex digits
	bneq	15$			; anything else stands for itself
	clrl	r5
	movl	#2,r4
45$:	tstl	r2
	bleq	48$
	movzbl	(r1),r0
	pushl	r0
	jsb	s_digval
	cmpl	r0,#16
	bgequ	47$
	tstl	(sp)+
	ashl	#4,r5,r5
	addl2	r0,r5
	incl	r1
	decl	r2
	sobgtr	r4,45$
	brb	48$
47$:	tstl	(sp)+
48$:	movl	r5,r0
	brb	15$
90$:	subl3	v_srcaddr,r1,v_toin
	moval	v_xbuf,r6
	subl3	r6,r3,r7
	rsb

v_escapes:
	.ascii	/a/<7>/b/<8>/e/<27>/f/<12>/l/<10>/n/<10>/q/<34>/r/<13>
	.ascii	/t/<9>/v/<11>/z/<0>/"/<34>/\/<92>
