	newpage	<Conditional Compilation>
;+++
;s> s_namecmp -- compare r6, r7 with the counted string at r2,
;	ignoring case.  Z set if they are the same.  Uses r0-r4.
;---
s_namecmp:
	movzbl	(r2)+,r0
	cmpl	r0,r7
	bneq	20$
	tstl	r7
	beql	20$
	movl	r6,r1
	movl	r7,r4
10$:	movzbl	(r1)+,r0
	movzbl	(r2)+,r3
	cmpb	v_upper[r0],v_upper[r3]
	bneq	20$
	sobgtr	r4,10$
	clrl	r0			; Z set: equal
20$:	rsb

;+++
;t> [ELSE] -- ( -- ) skip to the matching [THEN], counting nested [IF]s.
;---
	defword	bracketelse,^~[ELSE]~,f_imm
	movl	#1,-(sp)		; nesting level
10$:	jsb	parsename
	movl	(r11)+,r7
	movl	(r11)+,r6
	tstl	r7
	bneq	20$
	jsb	refill			; end of line: get another
	tstl	(r11)+
	bneq	10$
	tstl	(sp)+			; end of input
	rsb
20$:	moval	v_sif,r2
	jsb	s_namecmp
	bneq	30$
	incl	(sp)			; [IF]: one deeper
	brb	10$
30$:	moval	v_selse,r2
	jsb	s_namecmp
	bneq	40$
	decl	(sp)			; [ELSE]
	beql	50$			; at our level: done
	incl	(sp)
	brb	10$
40$:	moval	v_sthen,r2
	jsb	s_namecmp
	bneq	10$
	decl	(sp)			; [THEN]
	bneq	10$
50$:	tstl	(sp)+
	rsb

v_sif:	cstring	<[IF]>
v_selse: cstring <[ELSE]>
v_sthen: cstring <[THEN]>

