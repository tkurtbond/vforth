10$:	movl	#^a/)/,-(r11)
	jsb	parse
	addl2	#8,r11
	tstl	v_toin			; found the ) ?
	beql	20$
	addl3	v_srcaddr,v_toin,r0
	cmpb	-1(r0),#^a/)/
	beql	30$
20$:	tstl	v_srcid			; no: in a file?
	bleq	30$
	tstl	v_blk
	bneq	30$
	jsb	refill			; yes, go on to the next line
	tstl	(r11)+
	bneq	10$
30$:	rsb

;+++
;c> \ -- ( "ccc<eol>" -- )
;---
