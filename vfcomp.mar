r_sstring:
	tstl	v_state
	beql	10$
	brw	s_cslit
10$:	jsb	s_sbuf
	movl	r6,-(r11)
	movl	r7,-(r11)
	rsb

;+++
;c> S\" -- ( "ccc<quote>" -- c-addr u ) with escapes.
;---
	defword	sbackquote,^~S\"~,f_imm
	jsb	s_parseescaped
	brb	r_sstring

;+++
;c> C" -- ( "ccc<quote>" -- c-addr )
;---
