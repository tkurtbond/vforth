	newpage	<Strings>
;******************************************************************************
;
; VFSTRING.MAR -- the String word set.
;
;******************************************************************************
	.psect	vf_code

;+++
;s> -TRAILING -- ( c-addr u1 -- c-addr u2 )
;---
	defword	dashtrailing,^~-TRAILING~
	movl	(r11),r0
	movl	4(r11),r1
10$:	tstl	r0
	bleq	20$
	cmpb	-1(r1)[r0],#c_bl
	bneq	20$
	decl	r0
	brb	10$
20$:	movl	r0,(r11)
	rsb

;+++
;s> /STRING -- ( c-addr1 u1 n -- c-addr2 u2 )
;---
	defword	slashstring,^~/STRING~,inl=1
	movl	(r11)+,r0
	subl2	r0,(r11)
	addl2	r0,4(r11)
slashstring_e: rsb

;+++
;s> COMPARE -- ( c-addr1 u1 c-addr2 u2 -- n )
;---
	defword	compare,^~COMPARE~
	movl	(r11)+,r7		; u2
	movl	(r11)+,r3		; c-addr2
	movl	(r11)+,r6		; u1
	movl	(r11),r1		; c-addr1
	movl	r6,r8			; the shorter length
	cmpl	r7,r8
	bgeq	10$
	movl	r7,r8
10$:	tstl	r8			; compare that much, in pieces
	bleq	30$
	movzwl	#65535,r0
	cmpl	r8,r0
	bgeq	20$
	movl	r8,r0
20$:	subl2	r0,r8
	cmpc3	r0,(r1),(r3)
	beql	10$
	blssu	50$			; first string less
	brb	60$
30$:	cmpl	r6,r7			; same so far: the shorter is less
	blss	50$
	bgtr	60$
	clrl	(r11)
	rsb
50$:	mnegl	#1,(r11)
	rsb
60$:	movl	#1,(r11)
	rsb

;+++
;s> SEARCH -- ( c-addr1 u1 c-addr2 u2 -- c-addr3 u3 flag )
;---
	defword	search,^~SEARCH~
	movl	(r11),r6		; u2
	bneq	5$
	addl2	#4,r11			; an empty string is always found
	mnegl	#1,(r11)
	rsb
5$:	movl	4(r11),r7		; c-addr2
	movl	8(r11),r8		; u1
	movl	12(r11),r4		; where to look
	movl	r8,r5			; how much is left
10$:	cmpl	r5,r6			; room for it?
	blss	40$
	cmpc3	r6,(r4),(r7)
	beql	30$
	incl	r4
	decl	r5
	brb	10$
30$:	movl	r4,12(r11)		; found
	movl	r5,8(r11)
	addl2	#4,r11
	mnegl	#1,(r11)
	rsb
40$:	addl2	#4,r11			; not found
	clrl	(r11)
	rsb

;+++
;s> SUBSTITUTE, REPLACES, UNESCAPE -- text substitution.  The names
;	REPLACES defines are kept, with their text, in memory from
;	LIB$GET_VM, each:
;	long	-- the next one
;	long	-- address of the text (its own LIB$GET_VM memory)
;	long	-- length of the text
;	byte	-- length of the name, then the name
;---
	.psect	vf_data
v_substs:	.long	0
c_substsize = 1024
v_substbuf:	.blkb	c_substsize	; SUBSTITUTE's copy of an overlapping source
	.psect	vf_code

;+++
;s> s_findsubst -- find the substitution named r6, r7.  r0 = it, or 0.
;---
s_findsubst:
	movl	v_substs,r0
10$:	beql	30$
	movzbl	12(r0),r1
	cmpl	r1,r7
	bneq	20$
	pushr	#^m<r0>
	moval	12(r0),r2
	jsb	s_namecmp		; (ignoring case)
	popr	#^m<r0>			; (keeps the condition codes)
	beql	30$
20$:	movl	(r0),r0
	brb	10$
30$:	tstl	r0
	rsb

;+++
;s> REPLACES -- ( c-addr1 u1 c-addr2 u2 -- ) make the name c-addr2 u2
;	stand for the text c-addr1 u1.
;---
	defword	replaces,^~REPLACES~
	movl	(r11),r7
	movl	4(r11),r6
	cmpl	r7,#255
	blequ	5$
	throw	t_replaces
5$:	jsb	s_findsubst
	bneq	10$
	addl3	#13,r7,v_vmsize		; a new one
	pushal	v_vmaddr
	pushal	v_vmsize
	calls	#2,g^lib$get_vm
	blbs	r0,7$
	throw	t_replaces
7$:	movl	v_vmaddr,r8
	movl	v_substs,(r8)
	movl	r8,v_substs
	clrq	4(r8)
	movb	r7,12(r8)
	movc3	r7,(r6),13(r8)
	brb	20$
10$:	movl	r0,r8			; an old one: free its text
	movl	4(r8),v_vmaddr
	beql	20$
	movl	8(r8),v_vmsize
	beql	20$
	pushal	v_vmaddr
	pushal	v_vmsize
	calls	#2,g^lib$free_vm
	clrq	4(r8)
20$:	movl	8(r11),r7		; copy the text
	movl	r7,8(r8)
	beql	30$
	movl	r7,v_vmsize
	pushal	v_vmaddr
	pushal	v_vmsize
	calls	#2,g^lib$get_vm
	blbs	r0,25$
	clrl	8(r8)
	throw	t_replaces
25$:	movl	v_vmaddr,4(r8)
	movl	8(r11),r7
	movl	12(r11),r6
	movc3	r7,(r6),@4(r8)
30$:	addl2	#16,r11
	rsb

;+++
;s> SUBSTITUTE -- ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n ) copy the
;	string c-addr1 u1 to the buffer c-addr2 u2, replacing each %name%
;	that REPLACES defined with its text, and %% with %.  n is the number
;	of substitutions, or negative if the result didn't fit.
;---
	defword	substitute,^~SUBSTITUTE~
	movl	12(r11),r1		; does the source overlap the buffer?
	movl	8(r11),r2
	addl3	r1,r2,r0
	cmpl	r0,4(r11)
	blequ	5$
	addl3	4(r11),(r11),r0
	cmpl	r0,r1
	blequ	5$
	cmpl	r2,#c_substsize		; yes: work from a copy of it
	blequ	3$
	movl	4(r11),12(r11)		; too long to copy
	clrl	8(r11)
	addl2	#4,r11
	movl	#t_subst,(r11)
	rsb
3$:	movc3	r2,(r1),v_substbuf
	moval	v_substbuf,12(r11)
5$:	movl	12(r11),r1		; source
	movl	8(r11),r2		; its length
	movl	4(r11),r3		; destination
	movl	(r11),r4		; room in it
	clrl	-(sp)			; substitutions
	clrl	-(sp)			; overflow flag
10$:	tstl	r2
	bgtr	11$
	brw	80$
11$:	movzbl	(r1)+,r0
	decl	r2
	cmpb	r0,#^a/%/
	beql	20$
15$:	tstl	r4			; copy a character
	bgtr	17$
	movl	#1,(sp)
	brb	10$
17$:	movb	r0,(r3)+
	decl	r4
	brb	10$
20$:	tstl	r2			; % at the end: copy it
	bleq	15$
	cmpb	(r1),#^a/%/		; %%: one %
	bneq	30$
	incl	r1
	decl	r2
	brb	15$
30$:	movl	r1,r6			; the name starts here
	locc	#^a/%/,r2,(r6)		; find the closing %
	bneq	35$
	movl	r6,r1			; none: copy the % as it is
	movl	#^a/%/,r0
	brw	15$
35$:	subl3	r6,r1,r7		; the name's length
	movl	r0,r5			; what is left, from the %
	pushr	#^m<r1,r2,r3,r4,r5>
	jsb	s_findsubst
	popr	#^m<r1,r2,r3,r4,r5>
	tstl	r0
	beql	50$
	incl	r1			; skip the name and %
	subl3	#1,r5,r2
	movl	8(r0),r5		; its text
	movl	4(r0),r6
	incl	4(sp)
40$:	tstl	r5
	bleq	10$
	tstl	r4
	bgtr	45$
	movl	#1,(sp)
	brw	10$
45$:	movb	(r6)+,(r3)+
	decl	r4
	decl	r5
	brb	40$
50$:	movl	r6,r1			; not a name: copy the % as it is
	movl	#^a/%/,r0
	brw	15$
80$:	subl3	4(r11),r3,r3		; length of the result
	movl	4(r11),12(r11)
	movl	r3,8(r11)
	addl2	#4,r11
	movl	(sp)+,r0		; overflowed?
	movl	(sp)+,(r11)
	tstl	r0
	beql	90$
	movl	#t_subst,(r11)
90$:	rsb

;+++
;s> UNESCAPE -- ( c-addr1 u1 c-addr2 -- c-addr2 u2 ) copy with each %
;	doubled.
;---
	defword	unescape,^~UNESCAPE~
	movl	(r11)+,r3
	movl	(r11),r2
	movl	4(r11),r1
	movl	r3,4(r11)
	tstl	r2
	bleq	30$
10$:	movb	(r1)+,r0
	movb	r0,(r3)+
	cmpb	r0,#^a/%/
	bneq	20$
	movb	r0,(r3)+
20$:	sobgtr	r2,10$
30$:	subl3	4(r11),r3,(r11)
	rsb
