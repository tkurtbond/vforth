! DESCRIP.MMS -- builds VFORTH, a Forth 2012 system for VAX/VMS, with MMS.
!
!   MMS             builds VFORTH.EXE and VFORTHDBG.EXE
!   MMS CLEAN       deletes what MMS made

SOURCES = VFMACROS+VFDATA+VFCORE+VFTERM+VFNUM+VFINTERP+VFCOMP+VFLOCALS+-
VFSEARCH+VFSTRING+VFDOUBLE+VFTOOLS+VFFILE+VFBLOCK+VFFLOAT+VFMAIN
DEPS = VFMACROS.MAR,VFDATA.MAR,VFCORE.MAR,VFTERM.MAR,VFNUM.MAR,-
VFINTERP.MAR,VFCOMP.MAR,VFLOCALS.MAR,VFSEARCH.MAR,VFSTRING.MAR,VFDOUBLE.MAR,-
VFTOOLS.MAR,VFFILE.MAR,VFBLOCK.MAR,VFFLOAT.MAR,VFMAIN.MAR

all : vforth.exe vforthdbg.exe
	@ ! done

vforth.exe : vforth.obj
	LINK/MAP/FULL/EXE=VFORTH.EXE VFORTH.OBJ

vforth.obj : $(DEPS)
	MACRO/LIST=VFORTH.LIS/OBJECT=VFORTH.OBJ $(SOURCES)

vforthdbg.exe : vforthdbg.obj
	LINK/DEBUG/MAP=VFORTHDBG.MAP/EXE=VFORTHDBG.EXE VFORTHDBG.OBJ

vforthdbg.obj : vfdbg.mar $(DEPS)
	MACRO/DEBUG/NOLIST/OBJECT=VFORTHDBG.OBJ VFDBG+$(SOURCES)

clean :
	- DELETE/LOG *.EXE;*,*.OBJ;*,*.LIS;*,*.MAP;*
